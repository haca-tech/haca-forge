# Server & Runtime
PORT=8080
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/marketing_portal

# Auth & Tokens
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_min
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Cookies
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=

# Email (docs/EMAIL.md). "console" (default) logs each email and sends nothing.
# "resend" sends via Resend HTTPS API (recommended for production); RESEND_API_KEY and EMAIL_FROM required.
# "smtp" sends through Gmail / Nodemailer; then every SMTP_* value and EMAIL_FROM is required.
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM="HACA Forge <onboarding@resend.dev>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-character-app-password
# Optional PNG logo for the email header (never SVG). Empty: the "HACA FORGE" text wordmark.
EMAIL_LOGO_URL=

# Phone verification codes go to the user's registered email. "sms" is refused until a provider exists.
PHONE_OTP_CHANNEL=email

# Initial Admin & Demo Seeding
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=AdminStrongPass123!


# File storage (docs/STORAGE.md). "local" (default) keeps files in apps/api/uploads.
# "bunny" stores them on Bunny Storage and serves them through a Pull Zone with signed URLs;
# then every BUNNY_* value below is required.
STORAGE_DRIVER=local
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_KEY=
BUNNY_CDN_URL=
BUNNY_TOKEN_KEY=


