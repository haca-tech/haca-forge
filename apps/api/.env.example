# Server & Runtime
PORT=8080
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/marketing_portal
REDIS_URL=redis://127.0.0.1:6379

# Auth & Tokens
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_min
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Cookies
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=

# Email Provider (console | smtp | resend)
EMAIL_PROVIDER=console
MAIL_FROM="Marketing Portal <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Initial Admin & Demo Seeding
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=AdminStrongPass123!


# File storage (docs/STORAGE.md). "local" (default) keeps files in apps/api/uploads.
# "bunny" stores them on Bunny Storage and serves them through a Pull Zone with signed URLs;
# then every BUNNY_* value below is required.
STORAGE_DRIVER=local
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_KEY=
BUNNY_CDN_URL=
BUNNY_TOKEN_KEY=


