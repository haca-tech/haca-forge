VITE_API_BASE_URL=http://localhost:8080/api
VITE_SOCKET_URL=http://localhost:8080
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Optional, local development only: quick sign in buttons on the login page.
# Put it in .env.local (ignored by git), as base64 of [{"label","email","password"}].
# VITE_QUICK_LOGINS=
# Also show quick sign in in a production build (npm run build). TEMPORARY, for testing only:
# it puts every listed password in the page code. Delete this line before hosting.
# VITE_QUICK_LOGIN_IN_BUILD=true
# The hosted build sets VITE_DEPLOY_TARGET=production (a Vercel production deploy counts as
# production too). A build with both fails, so the passwords can never reach the hosted site.
# VITE_DEPLOY_TARGET=production
